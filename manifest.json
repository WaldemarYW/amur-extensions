{
  "manifest_version": 3,
  "name": "amur extensions",
  "short_name": "amur",
  "version": "1.26.0",
  "description": "Показує денний баланс і залишки повідомлень та листів на alpha.date.",
  "permissions": ["storage"],
  "host_permissions": ["https://alpha.date/*"],
  "content_scripts": [
    {
      "matches": ["https://alpha.date/*"],
      "js": ["chat-list-api-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://alpha.date/*"],
      "css": ["balance.css"],
      "js": ["balance.js", "autolike.js"],
      "run_at": "document_idle"
    }
  ]
}
